---
// Tapping an image in an article opens it over the page instead of in a new
// tab: zoomed so a diagram's text is readable on a phone, pannable, and closed
// by the button, a tap outside, Escape or the Back button - which returns to
// the article where the reader left it. Without JavaScript the link still
// opens the file (scripts/rehype-image-links.mjs).
// Mounted once per markdown layout (BlogPost, TrainingLesson).
---

<dialog class="image-zoom" aria-label="Image, enlarged">
	<button type="button" class="image-zoom-close" aria-label="Close image">Close</button>
	<div class="image-zoom-scroll">
		<img alt="" />
	</div>
	<p class="image-zoom-hint">Tap the image to fit it or zoom it. Drag to move around.</p>
</dialog>

<script>
	const dialog = document.querySelector<HTMLDialogElement>('dialog.image-zoom');
	const picture = dialog?.querySelector('img');
	const scroller = dialog?.querySelector<HTMLElement>('.image-zoom-scroll');

	if (dialog && picture && scroller && typeof dialog.showModal === 'function') {
		const close = () => {
			if (dialog.open) dialog.close();
		};

		document.addEventListener('click', (event) => {
			const link = (event.target as Element | null)?.closest<HTMLAnchorElement>('article.prose a.img-link');
			// A modified click still opens the file in a new tab, as before.
			if (!link || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button !== 0) return;
			const source = link.querySelector('img');
			if (!source) return;
			event.preventDefault();
			picture.src = link.href;
			picture.alt = source.alt;
			// Start zoomed where fitting the screen would leave the text too small to read.
			dialog.classList.toggle('is-zoomed', source.naturalWidth > source.naturalHeight && window.innerWidth < 800);
			dialog.showModal();
			scroller.scrollTo(0, 0);
			// So the Back button closes the image instead of leaving the article.
			history.pushState({ imageZoom: true }, '');
		});

		picture.addEventListener('click', () => dialog.classList.toggle('is-zoomed'));
		dialog.querySelector('.image-zoom-close')?.addEventListener('click', close);
		// A tap on the backdrop or the empty space around the image.
		dialog.addEventListener('click', (event) => {
			if (event.target === dialog || event.target === scroller) close();
		});
		window.addEventListener('popstate', close);
		dialog.addEventListener('close', () => {
			picture.removeAttribute('src');
			if (history.state?.imageZoom) history.back();
		});
	}
</script>

<style is:global>
	dialog.image-zoom {
		width: 100vw;
		max-width: 100vw;
		height: 100dvh;
		max-height: 100dvh;
		margin: 0;
		padding: 0;
		border: 0;
		background: rgb(13, 16, 25);
		color: rgb(214, 220, 235);
		flex-direction: column;
	}
	dialog.image-zoom[open] {
		display: flex;
	}
	dialog.image-zoom::backdrop {
		background: rgb(13, 16, 25);
	}
	.image-zoom-scroll {
		flex: 1;
		min-height: 0;
		overflow: auto;
		display: flex;
		-webkit-overflow-scrolling: touch;
		overscroll-behavior: contain;
	}
	.image-zoom-scroll img {
		flex: none;
		margin: auto;
		max-width: 100%;
		max-height: 100%;
		width: auto;
		height: auto;
		border-radius: 0;
		box-shadow: none;
		cursor: zoom-in;
	}
	/* Zoomed: wide enough to read, and the reader pans. */
	dialog.image-zoom.is-zoomed .image-zoom-scroll img {
		max-width: none;
		max-height: none;
		width: max(100%, 1100px);
		cursor: zoom-out;
	}
	.image-zoom-close {
		position: absolute;
		top: 0.75rem;
		right: 0.75rem;
		z-index: 1;
		padding: 0.5rem 0.9rem;
		border: 1px solid rgba(214, 220, 235, 0.4);
		border-radius: 999px;
		background: rgba(13, 16, 25, 0.85);
		color: inherit;
		font: inherit;
		font-size: 0.9rem;
		cursor: pointer;
	}
	.image-zoom-hint {
		margin: 0;
		padding: 0.5rem 1rem calc(0.5rem + env(safe-area-inset-bottom));
		font-size: 0.8rem;
		text-align: center;
		color: rgb(140, 156, 188);
	}
	a.img-link {
		cursor: zoom-in;
	}
</style>
